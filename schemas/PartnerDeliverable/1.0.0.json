{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdmo-agent-contracts:PartnerDeliverable:1.0.0",
  "title": "Partner deliverable",
  "description": "Something a CRO, CDMO, licensee or academic partner owes or has sent for an asset (report, data package, CoA ...). Validators check that a received deliverable has received_at and at least one document.",
  "x-contract-version": "1.0.0",
  "type": "object",
  "required": [
    "deliverable_id",
    "asset_id",
    "partner_id",
    "deliverable_type",
    "title",
    "status"
  ],
  "properties": {
    "deliverable_id": {
      "$ref": "urn:cdmo-agent-contracts:Common:1.0.0#/$defs/identifier"
    },
    "asset_id": {
      "$ref": "urn:cdmo-agent-contracts:PharmaCommon:1.0.0#/$defs/assetId"
    },
    "partner_id": {
      "$ref": "urn:cdmo-agent-contracts:PharmaCommon:1.0.0#/$defs/partnerId"
    },
    "deliverable_type": {
      "enum": [
        "study_report",
        "data_package",
        "cmc_report",
        "batch_record",
        "certificate_of_analysis",
        "regulatory_document",
        "protocol",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "study_id": {
      "$ref": "urn:cdmo-agent-contracts:PharmaCommon:1.0.0#/$defs/studyId"
    },
    "batch_id": {
      "$ref": "urn:cdmo-agent-contracts:PharmaCommon:1.0.0#/$defs/batchId"
    },
    "deal_id": {
      "$ref": "urn:cdmo-agent-contracts:PharmaCommon:1.0.0#/$defs/dealId"
    },
    "contract_ref": {
      "$ref": "urn:cdmo-agent-contracts:Common:1.0.0#/$defs/identifier"
    },
    "status": {
      "enum": [
        "expected",
        "received",
        "under_review",
        "accepted",
        "rejected"
      ]
    },
    "due_date": {
      "$ref": "urn:cdmo-agent-contracts:Common:1.0.0#/$defs/date"
    },
    "received_at": {
      "$ref": "urn:cdmo-agent-contracts:Common:1.0.0#/$defs/timestamp"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "urn:cdmo-agent-contracts:Common:1.0.0#/$defs/attachment"
      }
    },
    "ingestion": {
      "type": "object",
      "required": [
        "source_system"
      ],
      "properties": {
        "source_system": {
          "$ref": "urn:cdmo-agent-contracts:Common:1.0.0#/$defs/identifier"
        },
        "document_id": {
          "$ref": "urn:cdmo-agent-contracts:Common:1.0.0#/$defs/identifier"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "fields_extracted": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "reviewed_by": {
      "$ref": "urn:cdmo-agent-contracts:Common:1.0.0#/$defs/person"
    },
    "notes": {
      "type": "string",
      "maxLength": 5000
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  }
}
